"""Scenario: what the browser does, step by step. Recorded by `screencraft record`.

Edit CONFIG, then write the storyboard in run(). Every take.* call animates the real
cursor/keyboard and logs an event; take.mark("name") stamps a time you can use in plan.py,
take.box("name", selector) stores an element's rectangle for the camera and callouts.
"""

CONFIG = {
    "base_url": "@@BASE_URL@@",
    "start_path": "/",
    "scale": 2,                                   # 2 → 3840×2160 footage
    "viewport": {"width": 1920, "height": 1080},
    "locale": "en-US",
    "cursor_start": [1150, 700],
}


